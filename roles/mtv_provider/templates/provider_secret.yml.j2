apiVersion: v1
kind: Secret
metadata:
  name: {{ _mtv_provider_secret_name }}
  namespace: {{ mtv_provider_provider_namespace }}
  labels:
    createdForProviderType: {{ _mtv_provider_forklift_type }}
    createdForResourceType: providers
    app.kubernetes.io/managed-by: {{ mtv_provider_managed_by_label }}
type: Opaque
stringData:
  user: {{ mtv_provider_source_username | to_json }}
  password: {{ mtv_provider_source_password | to_json }}
{% if not (mtv_provider_source_verify_ssl | bool) %}
  insecureSkipVerify: "true"
{% elif _mtv_provider_source_certificate | default('') | length > 0 %}
  ca.crt: {{ _mtv_provider_source_certificate | to_json }}
  cacert: {{ _mtv_provider_source_certificate | to_json }}
{% endif %}
