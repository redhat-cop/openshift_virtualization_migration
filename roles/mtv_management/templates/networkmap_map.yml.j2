destination:
{% if provider in ['vsphere', 'ovirt'] %}
{% if 'vsphere' == provider %}
{%  set __network_overrides = mtv_management_mtv_vmware_network_overrides %}
{%  set __source_network = mtv_vmware_network %}
{% else %}
{%  set __network_overrides = mtv_management_mtv_ovirt_network_overrides %}
{%  set __source_network = mtv_ovirt_network %}
{% endif %}
{# Destination type explicitly requested through the network map overrides, if any. #}
{% set __destination_type = (__network_overrides['network_destination_type'] | default('', true) | trim) if 'network_destination_type' in __network_overrides else '' %}
{# NAD explicitly requested through the network map overrides, as '<namespace>/<name>' or '<name>'. #}
{% set __override_nad = (__network_overrides['network_attachment_definition'] | default('', true) | trim) if 'network_attachment_definition' in __network_overrides else '' %}
{# Fall back to the pod network only when no NAD was discovered *and* none was explicitly requested. #}
{% set __should_use_pod = __destination_type == "pod" or (mtv_management_mtv_network_networkattachmentdefinition | length == 0 and __override_nad | length == 0) %}
{% if __destination_type == "ignored" %}
  type: ignored
{% elif __should_use_pod %}
  type: pod
{% else %}
{% if __override_nad | length > 0 %}
{%  set __override_nad_parts = __override_nad | ansible.builtin.split('/') %}
{%  set multus_nad_name = __override_nad_parts[1] if __override_nad_parts | length == 2 else __override_nad %}
{%  set multus_nad_namespace = __override_nad_parts[0] if __override_nad_parts | length == 2 else "default" %}
{% else %}
{%  set multus_nad_name = (mtv_management_mtv_network_networkattachmentdefinition | first).object.metadata.name %}
{%  set multus_nad_namespace = (mtv_management_mtv_network_networkattachmentdefinition | first).object.metadata.namespace %}
{% endif %}
  type: multus
  name: {{ multus_nad_name }}
  namespace: {{ multus_nad_namespace }}
{% endif %}
source:
  id: "{{ __source_network.id }}"
  name: "{{ __source_network.name }}"
{% endif %}
