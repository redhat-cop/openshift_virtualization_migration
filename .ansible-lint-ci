---
# .ansible-lint-ci
#
# CI-specific ansible-lint configuration for Tier 1 (instant feedback) workflows.
# Mirrors .ansible-lint but adds mock_modules and mock_roles for private Red Hat
# collection dependencies that are unavailable without AUTOMATION_HUB_TOKEN.
#
# This allows ansible-lint to run on pull_request events (including forks)
# without requiring secrets, catching the majority of lint issues while
# tolerating missing private dependencies.

profile: production

exclude_paths:
  - .ansible
  - .cache/
  - .github/
  - changelogs/
  - collections/
  - docs/
  - plugins/
  - scripts/
  - .pre-commit-config.yaml
  - .markdownlint-cli2.yaml
  - devfile.yaml

loop_var_prefix: ^(__|{role}_)

var_naming_pattern: ^[a-z_][a-z0-9_]*$

use_default_rules: true

skip_list:
  - fqcn[canonical]

enable_list:
  - empty-string-compare
  - no-log-password
  - no-same-owner
  - name[prefix]
  - yaml

warn_list:
  - yaml[line-length]

offline: true

kinds:
  - yaml: "**/*.yaml-too"

task_name_prefix: "{stem} | "

# Mock modules and roles unavailable at lint time:
# - Private Red Hat collections require AUTOMATION_HUB_TOKEN
# - Own collection modules and roles: offline: true skips the auto-install-from-source
#   step that ansible-compat normally performs, so FQCN resolution falls back
#   to whatever is already installed — which may be stale or absent locally.
mock_modules:
  - ansible.controller.license
  - ansible.controller.subscriptions
  - redhat.openshift.k8s
  - redhat.openshift.openshift_auth
  - redhat.openshift_virtualization.kubevirt_vm

mock_roles:
  - infra.aap_utilities.aap_setup_download
  - infra.aap_utilities.aap_setup_install
  - infra.aap_utilities.aap_setup_prepare
  # following mocks are required due to ansible.builtin.import_role in playbooks
  - infra.openshift_virtualization_migration.aap_cleanup
  - infra.openshift_virtualization_migration.aap_deploy
  - infra.openshift_virtualization_migration.aap_machine_credentials
  - infra.openshift_virtualization_migration.aap_seed
  - infra.openshift_virtualization_migration.bootstrap
  - infra.openshift_virtualization_migration.cluster_healthcheck
  - infra.openshift_virtualization_migration.create_mf_aap_token
  - infra.openshift_virtualization_migration.mtv_management
  - infra.openshift_virtualization_migration.mtv_migrate
  - infra.openshift_virtualization_migration.ocp_cleanup
...
