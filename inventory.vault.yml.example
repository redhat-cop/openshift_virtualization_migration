---
# Migration Factory v2 — Vault Variables
#
# Copy this file to inventory.vault.yml and encrypt with Ansible Vault:
#
#   cp inventory.vault.yml.example inventory.vault.yml
#   # Edit inventory.vault.yml with real values
#   ansible-vault encrypt inventory.vault.yml
#
# Usage:
#   ansible-playbook -i inventory.yml -e @inventory.vault.yml playbooks/seed_aap.yml --ask-vault-pass
#
# IMPORTANT: Never commit this file unencrypted.

# -------------------------------------------------------------------------
# AAP Controller
# -------------------------------------------------------------------------
vault_controller_password: ""

# -------------------------------------------------------------------------
# Container Registry (for EE image)
# -------------------------------------------------------------------------
vault_container_username: ""
vault_container_password: ""

# -------------------------------------------------------------------------
# Git Credentials
# -------------------------------------------------------------------------
vault_git_username: ""
vault_git_password: ""
# vault_git_ssh_private_key: |
#   -----BEGIN OPENSSH PRIVATE KEY-----
#   ...
#   -----END OPENSSH PRIVATE KEY-----
# vault_git_ssh_key_passphrase: ""

# -------------------------------------------------------------------------
# Automation Hub Tokens
# -------------------------------------------------------------------------
vault_automation_hub_certified_token: ""
vault_automation_hub_validated_token: ""

# -------------------------------------------------------------------------
# Source Environment Credentials
# -------------------------------------------------------------------------
# One set of credentials per source defined in inventory.yml.
# Variable names should match the vault references in your source host vars.

# VMware vSphere
# vault_vcenter_prod_username: ""
# vault_vcenter_prod_password: ""
# vault_vcenter_prod_certificate: |
#   -----BEGIN CERTIFICATE-----
#   ...
#   -----END CERTIFICATE-----

# VMware ESXi hosts (if using ESXi direct mode)
# vault_esxi_host1_password: ""
# vault_esxi_host2_password: ""

# Red Hat Virtualization (Phase 2)
# vault_rhv_username: ""
# vault_rhv_password: ""

# -------------------------------------------------------------------------
# Target Cluster Credentials
# -------------------------------------------------------------------------
# One API key per target cluster defined in inventory.yml.
# Variable names should match the vault references in your target host vars.

# vault_ocp_prod_api_key: ""
# vault_ocp_staging_api_key: ""
...
